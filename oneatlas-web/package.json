{
  "name": "oneatlas-web",
  "version": "1.0.0",
  "description": "OneAtlas web app — Next.js + Tailwind frontend for the OneAtlas API",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p ${PORT:-3001}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "license": "MIT",
  "dependencies": {
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
