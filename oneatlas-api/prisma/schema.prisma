// OneAtlas — AI model discovery & intelligence platform
// Database: PostgreSQL. All monetary values are USD per 1M tokens.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum OrganizationType {
  AI_LAB
  BIG_TECH
  STARTUP
  RESEARCH_INSTITUTE
  OPEN_SOURCE_COLLECTIVE
}

enum ModelType {
  CHAT
  REASONING
  CODE
  EMBEDDING
  IMAGE_GENERATION
  SPEECH_TO_TEXT
  TEXT_TO_SPEECH
  VIDEO_GENERATION
  MODERATION
}

enum ModelStatus {
  PREVIEW
  ACTIVE
  DEPRECATED
}

enum Modality {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  FILE
  EMBEDDING
}

enum BenchmarkCategory {
  GENERAL_KNOWLEDGE
  REASONING
  MATH
  CODING
  INSTRUCTION_FOLLOWING
  MULTIMODAL
  LONG_CONTEXT
  AGENTIC
}

/// An AI company or research lab that creates models.
model Organization {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  type        OrganizationType
  description String?
  website     String?
  country     String?          @db.VarChar(2) // ISO 3166-1 alpha-2
  foundedYear Int?
  logoUrl     String?
  /// Generated by the database: lower(name). Gives case-insensitive alphabetical sorting regardless of the
  /// server's collation (with "C" collation "o1" would sort after "Whisper"). Never written by the app.
  nameSortKey String? @default(dbgenerated())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  models Model[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Organization_name_trgm_idx")
  @@index([nameSortKey])
}

/// An inference provider / API platform that serves models (may serve models from many labs).
model Provider {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  website     String?
  apiBaseUrl  String?
  /// Generated by the database: lower(name). Gives case-insensitive alphabetical sorting regardless of the
  /// server's collation (with "C" collation "o1" would sort after "Whisper"). Never written by the app.
  nameSortKey String? @default(dbgenerated())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offerings ModelProvider[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Provider_name_trgm_idx")
  @@index([nameSortKey])
}

/// Normalised capability catalogue (tool calling, vision, JSON mode, ...).
model Capability {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  models ModelCapability[]
}

model Model {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  description      String?
  organizationId   String
  type             ModelType
  status           ModelStatus @default(ACTIVE)
  releaseDate      DateTime?   @db.Date
  contextWindow    Int?
  maxOutputTokens  Int?
  parameterCountB  Decimal?    @db.Decimal(10, 2) // billions of parameters
  openWeights      Boolean     @default(false)
  license          String?
  knowledgeCutoff  DateTime?   @db.Date
  inputModalities  Modality[]
  outputModalities Modality[]

  /// Denormalised: cheapest *available* provider price. Maintained by PricingService
  /// inside the same transaction that mutates offerings, so list endpoints can sort/filter
  /// on price with a plain indexed column instead of an aggregate join.
  minInputPrice  Decimal? @db.Decimal(12, 6)
  minOutputPrice Decimal? @db.Decimal(12, 6)
  providerCount  Int      @default(0)

  /// Generated by the database: lower(name). Gives case-insensitive alphabetical sorting regardless of the
  /// server's collation (with "C" collation "o1" would sort after "Whisper"). Never written by the app.
  nameSortKey String? @default(dbgenerated())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  capabilities ModelCapability[]
  offerings    ModelProvider[]
  benchmarks   BenchmarkResult[]

  @@index([organizationId])
  @@index([type])
  @@index([releaseDate])
  @@index([contextWindow])
  @@index([minInputPrice])
  @@index([minOutputPrice])
  @@index([nameSortKey])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Model_name_trgm_idx")
  @@index([slug(ops: raw("gin_trgm_ops"))], type: Gin, map: "Model_slug_trgm_idx")
}

model ModelCapability {
  modelId      String
  capabilityId String

  model      Model      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([modelId, capabilityId])
  @@index([capabilityId])
}

/// A provider's offering of a model — pricing and serving characteristics live here,
/// because the same model costs different amounts on different providers.
model ModelProvider {
  id                  String   @id @default(cuid())
  modelId             String
  providerId          String
  providerModelId     String // identifier used in the provider's own API
  inputPricePerMTok   Decimal  @db.Decimal(12, 6)
  outputPricePerMTok  Decimal  @db.Decimal(12, 6)
  cachedInputPerMTok  Decimal? @db.Decimal(12, 6)
  contextWindow       Int?
  maxOutputTokens     Int?
  avgLatencyMs        Int?
  throughputTps       Decimal? @db.Decimal(10, 2)
  uptimePct           Decimal? @db.Decimal(5, 2)
  isAvailable         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  model    Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([modelId, providerId])
  @@index([providerId])
}

model Benchmark {
  id             String            @id @default(cuid())
  slug           String            @unique
  name           String
  description    String?
  category       BenchmarkCategory
  unit           String            @default("%")
  minScore       Decimal           @default(0) @db.Decimal(10, 3)
  maxScore       Decimal           @default(100) @db.Decimal(10, 3)
  higherIsBetter Boolean           @default(true)
  url            String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  results BenchmarkResult[]

  @@index([category])
}

model BenchmarkResult {
  id          String    @id @default(cuid())
  modelId     String
  benchmarkId String
  score       Decimal   @db.Decimal(10, 3)
  sourceUrl   String?
  measuredAt  DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  model     Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmark Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@unique([modelId, benchmarkId])
  @@index([benchmarkId, score])
}
