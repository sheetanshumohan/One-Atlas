# PostgreSQL connection string (Neon / Railway / Render / local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneatlas?schema=public"
# Required for write endpoints (x-api-key header). Leave empty to disable all writes. >=16 chars in production.
ADMIN_API_KEY="change-me-to-a-long-random-string"
PORT=3000
# Comma-separated list, or * for any origin
CORS_ORIGINS="*"
# Per-IP rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_TTL_MS
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
# Shared secret the web app sends in x-client-key so its requests bypass per-IP rate limiting (>=16 chars in production)
TRUSTED_CLIENT_KEY=""
